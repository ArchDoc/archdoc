{
  "name": "@archdoc/cli",
  "version": "0.9.2",
  "description": "ArchDoc: an architecture model your coding agent reads before it edits, kept true as the code changes. The archdoc command and its explorer.",
  "keywords": [
    "architecture",
    "architecture-as-code",
    "c4",
    "mcp",
    "ai-agents",
    "documentation",
    "cli"
  ],
  "homepage": "https://archdoc.github.io",
  "bugs": "https://github.com/ArchDoc/archdoc/issues",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchDoc/archdoc.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "web"
  ],
  "bin": {
    "archdoc": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@archdoc/analyzers": "workspace:*",
    "@archdoc/core": "workspace:*",
    "@archdoc/federation": "workspace:*",
    "@archdoc/mcp": "workspace:*",
    "@archdoc/spec": "workspace:*",
    "commander": "^14.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "prepack": "node -e \"const fs=require('node:fs');fs.rmSync('web',{recursive:true,force:true});fs.cpSync('../../apps/web/dist','web',{recursive:true})\""
  },
  "publishConfig": {
    "access": "public"
  }
}
